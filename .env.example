# Server-side only. Never exposed to the browser.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# "live" calls the real API; "mock" uses the built-in simulator (results are flagged SIMULATED).
# If JEV_API_KEY is empty the app always runs in mock mode.
JEV_MODE=live
DATABASE_PATH=./data/jev-triage.db
